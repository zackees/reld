    {
      "name": "zlib-static",
      "language": "c",
      "stressors": ["static"],
      "revision": "v1.3.1",
      "url": "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz",
      "sha256": "UNPINNED",
      "archive_root": "zlib-1.3.1",
      "ldflags": ["-static"],
      "build": [
        ["sh", "-c", "./configure --static && make -j\"$JOBS\" example minigzip"]
      ],
      "smoke": [
        ["./example"],
        ["sh", "-c", "printf 'reld corpus\\n' | ./minigzip | ./minigzip -d | grep -qx 'reld corpus'"]
      ],
      "artifacts": ["example", "minigzip"],
      "timeout_seconds": 900
    },
    {
      "name": "sqlite",
      "language": "c",
      "stressors": ["pie", "glibc-symbol-versioning", "pthread"],
      "revision": "3.46.1",
      "url": "https://www.sqlite.org/2024/sqlite-amalgamation-3460100.zip",
      "sha256": "UNPINNED",
      "archive_root": "sqlite-amalgamation-3460100",
      "ldflags": [],
      "build": [
        ["sh", "-c", "$CC -O1 -DSQLITE_THREADSAFE=1 shell.c sqlite3.c $LDFLAGS -lpthread -lm -ldl -o sqlite3"]
      ],
      "smoke": [
        ["sh", "-c", "./sqlite3 :memory: 'select sqlite_version();' | grep -qx 3.46.1"]
      ],
      "artifacts": ["sqlite3"],
      "timeout_seconds": 900
    },
